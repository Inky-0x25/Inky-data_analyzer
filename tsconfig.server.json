{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",

        "strict": true,
        "noImplicitAny": true,
        "strictNullChecks": true,

        "allowJs": false,
        "isolatedModules": true,

        "lib": [
			"ES2022", 
			"DOM"
		],

        "types": [
            "node"
        ],

        "outDir": "./dist/server",
        "rootDir": ".",
        "noEmit": false
    },

    "include": [
        "server/**/*",
		"shared/**/*"
    ]
}